<dashboard version="1.1" script="setup_v3.js" hideEdit="true">
  <label>PSExposed Setup</label>
  <row>
    <panel>
      <html>
        <div style="max-width:600px;margin:40px auto;padding:0 20px;">
          <h2 style="font-size:20px;font-weight:600;margin-bottom:24px;color:#1a1c1e;">PSExposed API Key Configuration</h2>

          <div id="status-container" style="margin-bottom:20px;"></div>

          <label style="display:block;font-weight:500;font-size:14px;margin-bottom:8px;color:#333;">API Key</label>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
            <input type="password" id="api_key" placeholder=""
                   style="flex:1;max-width:460px;padding:8px 12px;border:1px solid #c3cbd4;border-radius:4px;font-size:14px;font-family:monospace;" />
            <button type="button" id="toggle-visibility" title="Show/Hide"
                    style="background:none;border:1px solid #c3cbd4;border-radius:4px;padding:6px 10px;cursor:pointer;font-size:16px;">
              &#128065;
            </button>
          </div>

          <button id="save-btn" type="button"
                  style="padding:8px 20px;border:1px solid #5cc05c;border-radius:4px;font-size:14px;font-weight:500;cursor:pointer;background:#fff;color:#333;">
            Save API Key
          </button>

          <div id="message" style="padding:12px 16px;border-radius:4px;margin-top:16px;font-size:13px;display:none;"></div>

          <div style="margin-top:32px;padding:16px;border-left:3px solid #5cc05c;background:#f6fdf6;">
            <p style="font-weight:600;font-size:14px;color:#333;margin-bottom:4px;">Help</p>
            <p style="font-size:13px;color:#555;line-height:1.6;margin:0;">
              Please enter your PSExposed API key above. You can find your API key in your
              <a href="https://powershell.exposed" target="_blank" style="color:#006fba;">powershell.exposed</a> account settings.
            </p>
          </div>
        </div>
      </html>
    </panel>
  </row>
</dashboard>
