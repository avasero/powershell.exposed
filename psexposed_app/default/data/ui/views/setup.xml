<dashboard version="1.1" script="setup_page.js" hideEdit="true">
  <label>PSExposed Setup</label>
  <row>
    <panel>
      <html>
        <div id="psexposed-setup-container" style="max-width:600px;padding:20px;">
          <h1 style="font-size:22px;margin-bottom:8px;color:#1a1c1e;">PSExposed Configuration</h1>
          <p style="color:#6c7785;font-size:14px;margin-bottom:24px;line-height:1.5;">
            Enter your powershell.exposed API key to enable PowerShell command analysis.
            Each Splunk user needs their own API key.
            Get yours at <a href="https://powershell.exposed" target="_blank">powershell.exposed</a>.
          </p>

          <div id="status-container" style="margin-bottom:16px;"></div>

          <div style="margin-bottom:20px;">
            <label style="display:block;font-weight:600;font-size:13px;margin-bottom:6px;">API Base URL</label>
            <p style="font-size:12px;color:#6c7785;margin-bottom:6px;">Only change this if you are running a self-hosted instance.</p>
            <input type="text" id="base_url" value="https://api.powershell.exposed"
                   style="width:100%;max-width:500px;padding:10px 12px;border:1px solid #c3cbd4;border-radius:4px;font-size:14px;font-family:monospace;" />
          </div>

          <div style="margin-bottom:20px;">
            <label style="display:block;font-weight:600;font-size:13px;margin-bottom:6px;">API Key</label>
            <p style="font-size:12px;color:#6c7785;margin-bottom:6px;">Your personal API key (starts with pse_).</p>
            <div id="current-key-display" style="font-size:13px;color:#6c7785;margin-bottom:4px;font-family:monospace;"></div>
            <input type="password" id="api_key" placeholder="pse_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
                   style="width:100%;max-width:500px;padding:10px 12px;border:1px solid #c3cbd4;border-radius:4px;font-size:14px;font-family:monospace;" />
          </div>

          <button id="save-btn" type="button"
                  style="padding:10px 24px;border:none;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer;background:#5cc05c;color:#fff;">
            Save Configuration
          </button>

          <div id="message" style="padding:12px 16px;border-radius:4px;margin-top:16px;font-size:13px;display:none;"></div>
        </div>
      </html>
    </panel>
  </row>
</dashboard>
