# PowerShell 7 on Windows Server Core - for local development on Windows Docker
FROM mcr.microsoft.com/powershell:lts-windowsservercore-ltsc2022

# Set working directory
WORKDIR C:/app

# Set execution policy
RUN pwsh -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Force"
RUN powershell.exe -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Force"

# Install Pode module for HTTP server functionality
RUN pwsh -Command "Set-PSRepository -Name PSGallery -InstallationPolicy Trusted; Install-Module -Name Pode -Force -Scope AllUsers"

# Create scripts directory
RUN pwsh -Command "New-Item -ItemType Directory -Path C:/app/scripts -Force"

# Copy PowerShell scripts
COPY scripts/ C:/app/scripts/
COPY server.ps1 C:/app/server.ps1

# Expose port
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD pwsh -Command "try { $r = Invoke-RestMethod -Uri 'http://localhost:8081/health' -Method Get -TimeoutSec 5; if ($r.status -eq 'healthy') { exit 0 } else { exit 1 } } catch { exit 1 }"

# Run the PowerShell HTTP server
CMD ["pwsh", "-NoProfile", "-File", "C:/app/server.ps1"]
